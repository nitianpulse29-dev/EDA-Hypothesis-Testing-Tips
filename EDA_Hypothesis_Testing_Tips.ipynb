    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "F = 0.845, p-value = 0.4703\n",
      "Kruskal-Wallis H = 1.849, p-value = 0.6044\n",
      "Fail to reject H0\n"
     ]
    }
   ],
   "source": [
    "groups = [g[\"tip_pct\"].values for _, g in df.groupby(\"day\", observed=True)]\n",
    "f, p = stats.f_oneway(*groups)\n",
    "print(f\"F = {f:.3f}, p-value = {p:.4f}\")\n",
    "# Non-parametric check (does not assume normality)\n",
    "h, p_kw = stats.kruskal(*groups)\n",
    "print(f\"Kruskal-Wallis H = {h:.3f}, p-value = {p_kw:.4f}\")\n",
    "print(\"Reject H0\" if p < 0.05 else \"Fail to reject H0\")"
   ]
