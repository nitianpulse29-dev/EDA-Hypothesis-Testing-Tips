      "Reject H0\n"
     ]
    }
   ],
   "source": [
    "r, p = stats.pearsonr(df[\"total_bill\"], df[\"tip\"])\n",
    "print(f\"Pearson r = {r:.3f}, p-value = {p:.2e}\")\n",
    "print(\"Reject H0\" if p < 0.05 else \"Fail to reject H0\")"
   ]
  },
