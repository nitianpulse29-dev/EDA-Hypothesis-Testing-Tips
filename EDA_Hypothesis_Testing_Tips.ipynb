   "source": [
    "# Remove the duplicate row(s) - they could be separate bills, but an exact copy is most likely a repeat entry\n",
    "df = df.drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "# Create a new feature: tip as a percentage of the bill\n",
    "df[\"tip_pct\"] = df[\"tip\"] / df[\"total_bill\"] * 100\n",
    "\n",
    "# Convert text columns to categorical type\n",
    "for col in [\"sex\", \"smoker\", \"day\", \"time\"]:\n",
    "    df[col] = df[col].astype(\"category\")\n",
    "\n",
    "print(\"Rows after cleaning:\", len(df))\n",
    "df[[\"total_bill\", \"tip\", \"tip_pct\"]].describe()"
   ]
  },
