   "source": [
    "# Normality check (Shapiro-Wilk). p < 0.05 means \"not perfectly normal\".\n",
    "for col in [\"total_bill\", \"tip\", \"tip_pct\"]:\n",
    "    stat, p = stats.shapiro(df[col])\n",
    "    print(f\"{col}: W = {stat:.3f}, p = {p:.4f}\")\n",
    "print(\"\\nWith n > 200 the t-test is robust to mild non-normality (Central Limit Theorem).\")"
   ]
  },
