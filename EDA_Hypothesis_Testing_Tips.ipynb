     "iopub.status.idle": "2026-10-31T18:00:11.422708Z",
     "shell.execute_reply": "2026-10-31T18:00:11.421869Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Smokers mean = 16.33%, Non-smokers mean = 15.93%\n",
      "t = 0.418, p-value = 0.6767\n",
      "Difference = 0.40%, 95% CI = (-1.48, 2.28)\n",
      "Fail to reject H0\n"
     ]
    }
   ],
   "source": [
    "smoker = df.loc[df[\"smoker\"] == \"Yes\", \"tip_pct\"]\n",
    "nonsmoker = df.loc[df[\"smoker\"] == \"No\", \"tip_pct\"]\n",
    "\n",
    "t, p = stats.ttest_ind(smoker, nonsmoker, equal_var=False)\n",
    "print(f\"Smokers mean = {smoker.mean():.2f}%, Non-smokers mean = {nonsmoker.mean():.2f}%\")\n",
    "print(f\"t = {t:.3f}, p-value = {p:.4f}\")\n",
    "\n",
    "# 95% confidence interval for the difference in means (Welch)\n",
    "diff = smoker.mean() - nonsmoker.mean()\n",
    "se = np.sqrt(smoker.var(ddof=1)/len(smoker) + nonsmoker.var(ddof=1)/len(nonsmoker))\n",
    "dof = se**4 / ((smoker.var(ddof=1)/len(smoker))**2/(len(smoker)-1) + (nonsmoker.var(ddof=1)/len(nonsmoker))**2/(len(nonsmoker)-1))\n",
    "ci = stats.t.interval(0.95, dof, loc=diff, scale=se)\n",
    "print(f\"Difference = {diff:.2f}%, 95% CI = ({ci[0]:.2f}, {ci[1]:.2f})\")\n",
    "print(\"Reject H0\" if p < 0.05 else \"Fail to reject H0\")"
   ]
  },
