   "source": [
    "# Outlier check using the IQR rule\n",
    "def iqr_outliers(s):\n",
    "    q1, q3 = s.quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    return s[(s < q1 - 1.5 * iqr) | (s > q3 + 1.5 * iqr)]\n",
    "\n",
    "for col in [\"total_bill\", \"tip\", \"tip_pct\"]:\n",
    "    print(f\"{col}: {len(iqr_outliers(df[col]))} outliers\")"
   ]
  },
